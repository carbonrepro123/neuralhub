APP_NAME=ClinixAI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://neuralhub.carbonrepro.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=clinixai
DB_USERNAME=clinixai_user
DB_PASSWORD=secret

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@clinixai.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clinixai-private
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DAILY_API_KEY=
DAILY_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=clinixai.daily.co

OCR_DRIVER=mock
AWS_TEXTRACT_ENABLED=false

SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

HIPAA_MINIMIZE_PHI=true
SIGNED_URL_TTL_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
